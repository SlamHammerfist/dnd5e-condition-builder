{
  "id": "dnd5e-condition-builder",
  "title": "D&D 5e Condition Builder",
  "description": "Replaces the raw JSON editor for Active Effect Change Conditions with a visual builder: pick a key, a comparison and a value, group rules with all/any/none, and see whether each rule passes for the actor right now.",
  "version": "1.0.0",
  "authors": [
    { "name": "Slam Hammerfist" }
  ],
  "url": "https://github.com/SlamHammerfist/dnd5e-condition-builder",
  "manifest": "https://github.com/SlamHammerfist/dnd5e-condition-builder/releases/latest/download/module.json",
  "download": "https://github.com/SlamHammerfist/dnd5e-condition-builder/releases/download/v1.0.0/module.zip",
  "bugs": "https://github.com/SlamHammerfist/dnd5e-condition-builder/issues",
  "readme": "https://github.com/SlamHammerfist/dnd5e-condition-builder/blob/main/README.md",
  "changelog": "https://github.com/SlamHammerfist/dnd5e-condition-builder/blob/main/CHANGELOG.md",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": { "minimum": "6.0.0", "verified": "6.1.1" }
      }
    ],
    "recommends": [
      {
        "id": "effect-select",
        "type": "module",
        "reason": "Gives the condition key field a searchable dropdown."
      }
    ]
  },
  "esmodules": [
    "scripts/condition-builder.mjs"
  ],
  "styles": [
    "styles/condition-builder.css"
  ],
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json" }
  ]
}
